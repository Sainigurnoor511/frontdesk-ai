# ── Supabase (Postgres + Auth) ────────────────────────────────────
# Point to your hosted Supabase project or local `supabase start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# CLI access token for `supabase db push` (optional; migrations CI uses GitHub secret)
SUPABASE_TOKEN=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENCRYPTION_KEY=

# ── Background jobs (BullMQ) + sign-in attempt budget ────────────
# Docker Compose runs Redis at redis://redis:6379/0 internally;
# for local dev outside Docker, use redis://localhost:6379/0
# Sign-in depends on this too: the TOTP code step reserves attempts here.
# Needs Redis >= 6.0 (releases use SET ... KEEPTTL); Compose ships Redis 7.
# If Redis is unreachable it fails closed ("temporarily unavailable"):
# within 1s once connected, 3s for a first connect that never completes.
# MFA users only; users without MFA sign in normally.
REDIS_URL=redis://redis:6379/0
# Test only: disposable Redis for lib/auth/mfa-attempts.test.ts script cases
# (default redis://127.0.0.1:6379/15; those cases skip when it is unreachable).
# MFA_REDIS_TEST_URL=

# ── LLM (extraction, generation) ─────────────────────────────────
GROQ_API_KEY=
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b

# ── Knowledge base (FastEmbed local BGE + hybrid FTS search) ─────
# Dense embeddings run in worker-knowledge / worker-voice (not on Vercel).
# Hybrid search fuses BGE vectors with Postgres full-text (BM25-like).
# Set FASTEMBED_DISABLED=1 for lexical-only search.
FASTEMBED_MODEL=bge-small-en-v1.5

# ── Voice — LiveKit (real-time room transport) ────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice — Call recordings (Supabase Storage S3-compatible API) ─
# Required for LiveKit Room Composite Egress → call-recordings bucket.
# Find these in Supabase Dashboard → Project Settings → Storage → S3 Access Keys.
SUPABASE_STORAGE_S3_ENDPOINT=
SUPABASE_STORAGE_S3_REGION=
SUPABASE_STORAGE_S3_ACCESS_KEY=
SUPABASE_STORAGE_S3_SECRET_KEY=

# ── Voice — Fish Audio (text-to-speech) ───────────────────────────
FISH_AUDIO_API_KEY=
# Opt-in progressive audio streaming (SSE) for lower time-to-first-audio.
# Off by default until the streaming endpoint is verified against the free tier.
FISH_AUDIO_TTS_STREAMING=0

# ── Voice — AssemblyAI (managed Voice Agent API) ──────────────────
# Alternative voice engine, selected per-agent via `agents.voice_provider`.
# One managed WebSocket owns STT + LLM + TTS + turn detection, so neither
# LiveKit nor Fish Audio is involved when an agent runs on this provider.
# Create a key at https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=
# Signing secret for the session.completed webhook subscription. Must match
# the `secret` registered via `pnpm assemblyai:webhook` (32–256 ASCII chars,
# no whitespace). Deliveries are rejected when this is unset.
ASSEMBLYAI_WEBHOOK_SECRET=

# ── Bot protection — Cloudflare Turnstile (public booking page) ───
# Site key is public (client-side); secret key verifies tokens server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email — Resend (appointment confirmations) ────────────────────
# Required on any deployment with two-factor enabled: it sends the only
# out-of-band alert that a recovery code removed a user's two-factor. Without
# it that alert is just an error log line, [mfa-recovery-notice-failed].
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Integrations — Google Calendar (OAuth2) ───────────────────────
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_WEBHOOK_SECRET=

# ── Integrations — Microsoft Calendar (OAuth2) ────────────────────
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional; defaults to "common"
MICROSOFT_CALENDAR_TENANT_ID=

# ── Integrations — Calendly ────────────────────────────────────────
# Per-org token/URIs are configured in the Integrations UI.

# ── Integrations — Telephony (Twilio / Plivo / SIP trunking) ───────
# Credentials are configured per-org in the Integrations UI.

# ── Webhook tool (shared signing secret) ──────────────────────────
WEBHOOK_SECRET_KEY=
