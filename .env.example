# Supabase (Postgres + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Background jobs (BullMQ)
REDIS_URL=redis://localhost:6379/0

# LLM (extraction, generation)
GROQ_API_KEY=
# Model for the in-app Assistant chatbot (tool-calling agent)
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b

# Voice — LiveKit (real-time room transport)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice — Fish Audio (text-to-speech)
FISH_AUDIO_API_KEY=

# Bot protection — Cloudflare Turnstile (public booking page)
# Site key is public (client-side); secret key verifies tokens server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email — Resend (appointment confirmations)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
