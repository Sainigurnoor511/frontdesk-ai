# ── Supabase (Postgres + Auth) ────────────────────────────────────
# Point to your hosted Supabase project or local `supabase start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Background jobs (BullMQ) ─────────────────────────────────────
# Docker Compose runs Redis at redis://redis:6379/0 internally;
# for local dev outside Docker, use redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ── LLM (extraction, generation) ─────────────────────────────────
GROQ_API_KEY=
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b

# ── Voice — LiveKit (real-time room transport) ────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice — Fish Audio (text-to-speech) ───────────────────────────
FISH_AUDIO_API_KEY=
# Opt-in progressive audio streaming (SSE) for lower time-to-first-audio.
# Off by default until the streaming endpoint is verified against the free tier.
FISH_AUDIO_TTS_STREAMING=0

# Bot protection — Cloudflare Turnstile (public booking page)
# Site key is public (client-side); secret key verifies tokens server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email — Resend (appointment confirmations)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Integrations — Google Calendar (OAuth2)
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_WEBHOOK_SECRET=

# Webhook tool (shared signing secret)
WEBHOOK_SECRET_KEY=
